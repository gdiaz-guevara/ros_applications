<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"  name="naoH25V40">
    <xacro:include filename="$(find nao_gz_controller)/urdf/nao_description.urdf"/>
    <xacro:arg name="controller" default="ros_controller"/>

    <ros2_control name="GazeboSimSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <!-- PIERNAS IZQUIERDA -->
        <joint name="LHipYawPitch">
            <command_interface name="position">
            <param name="min">-1.14529</param>
            <param name="max">0.740718</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="LHipRoll">
            <command_interface name="position">
            <param name="min">-0.379435</param>
            <param name="max">0.79046</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">0.02</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="LHipPitch">
            <command_interface name="position">
            <param name="min">-1.53589</param>
            <param name="max">0.48398</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">-0.45</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="LKneePitch">
            <command_interface name="position">
            <param name="min">-0.0923279</param>
            <param name="max">2.11255</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">0.70</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="LAnklePitch">
            <command_interface name="position">
            <param name="min">-1.18944</param>
            <param name="max">0.922581</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">-0.25</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="LAnkleRoll">
            <command_interface name="position">
            <param name="min">-0.397761</param>
            <param name="max">0.768992</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">-0.02</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <!-- PIERNAS DERECHA -->
        <joint name="RHipYawPitch">
            <command_interface name="position">
            <param name="min">-1.14529</param>
            <param name="max">0.740718</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="RHipRoll">
            <command_interface name="position">
            <param name="min">-0.79046</param>
            <param name="max">0.379435</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">-0.02</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="RHipPitch">
            <command_interface name="position">
            <param name="min">-1.53589</param>
            <param name="max">0.48398</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">-0.45</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="RKneePitch">
            <command_interface name="position">
            <param name="min">-0.0923279</param>
            <param name="max">2.11255</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">0.70</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="RAnklePitch">
            <command_interface name="position">
            <param name="min">-1.18944</param>
            <param name="max">0.922581</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">-0.25</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="RAnkleRoll">
            <command_interface name="position">
            <param name="min">-0.768992</param>
            <param name="max">0.397761</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">0.02</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <!-- BRAZO IZQUIERDO -->
        <joint name="LShoulderPitch">
            <command_interface name="position">
            <param name="min">-2.08567</param>
            <param name="max">2.08567</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">1.5</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="LShoulderRoll">
            <command_interface name="position">
            <param name="min">-0.314159</param>
            <param name="max">1.32645</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">0.2</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="LElbowYaw">
            <command_interface name="position">
            <param name="min">-2.08567</param>
            <param name="max">2.08567</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">-1.2</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="LElbowRoll">
            <command_interface name="position">
            <param name="min">-1.54462</param>
            <param name="max">-0.0349066</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">-0.5</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="LWristYaw">
            <command_interface name="position">
            <param name="min">-1.82387</param>
            <param name="max">1.82387</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <!-- BRAZO DERECHO -->
        <joint name="RShoulderPitch">
            <command_interface name="position">
            <param name="min">-2.08567</param>
            <param name="max">2.08567</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">1.5</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="RShoulderRoll">
            <command_interface name="position">
            <param name="min">-1.32645</param>
            <param name="max">0.314159</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">-0.2</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="RElbowYaw">
            <command_interface name="position">
            <param name="min">-2.08567</param>
            <param name="max">2.08567</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">1.2</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="RElbowRoll">
            <command_interface name="position">
            <param name="min">0.0349066</param>
            <param name="max">1.54462</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">0.5</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="RWristYaw">
            <command_interface name="position">
            <param name="min">-1.82387</param>
            <param name="max">1.82387</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>

        <!-- CABEZA -->
        <joint name="HeadYaw">
            <command_interface name="position">
            <param name="min">-2.08567</param>
            <param name="max">2.08567</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
        <joint name="HeadPitch">
            <command_interface name="position">
            <param name="min">-0.671952</param>
            <param name="max">0.514872</param>
            </command_interface>
            <state_interface name="position">
            <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>

    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find nao_gz_controller)/config/nao_controllers.yaml</parameters>
        </plugin>
    </gazebo>

</robot>