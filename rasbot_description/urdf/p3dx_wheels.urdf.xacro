<?xml version="1.0"?>
<robot name="p3dx_wheel" xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:macro name="p3dx_wheel" params="suffix reflect">

  <!-- Wheel -->
  <link name="p3dx_${suffix}_wheel">
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0124" ixy="0" ixz="0"
               iyy="0.0152" iyz="0"
               izz="0.0117"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://rasbot_description/meshes/p3dx/${suffix}_wheel.stl"/>
      </geometry>
      <material name="WheelBlack"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="${-3.14159/2} 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.02"/>
      </geometry>
    </collision>
  </link>

  <!-- Hubcap -->
  <link name="p3dx_${suffix}_hubcap">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0"
               izz="0.001"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://rasbot_description/meshes/p3dx/${suffix}_hubcap.stl"/>
      </geometry>
      <material name="HubcapYellow"/>
    </visual>

    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- Hubcap → Wheel (fixed) -->
  <joint name="p3dx_${suffix}_hubcap_joint" type="fixed">
    <origin xyz="0 0 0"/>
    <parent link="p3dx_${suffix}_wheel"/>
    <child link="p3dx_${suffix}_hubcap"/>
  </joint>

  <!-- Wheel → Base (continuous) -->
  <joint name="p3dx_${suffix}_wheel_joint" type="continuous">
    <origin xyz="0 ${reflect * 0.158} 0.091"/>
    <parent link="base_link"/>
    <child link="p3dx_${suffix}_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

</xacro:macro>
</robot>