<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="p3dx_caster" params="">

    <!-- Swivel -->
    <link name="caster_swivel">
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.01" ixy="0" ixz="0"
                 iyy="0.01" iyz="0"
                 izz="0.01"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://rasbot_description/meshes/p3dx/caster_swivel.stl"/>
        </geometry>
        <material name="CasterGrey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0"/>
        <geometry>
          <box size="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <joint name="base_caster_swivel_joint" type="continuous">
      <origin xyz="-0.185 0 0.055"/>
      <parent link="base_link"/>
      <child link="caster_swivel"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.0" friction="0.0"/>
      <limit effort="100" velocity="100" k_velocity="0"/>
    </joint>

    <!-- Center wheel -->
    <link name="caster_wheel">
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.0124" ixy="0" ixz="0"
                 iyy="0.0152" iyz="0"
                 izz="0.0117"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://rasbot_description/meshes/p3dx/caster_wheel.stl"/>
        </geometry>
        <material name="WheelBlack"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${-3.14159/2} 0 0"/>
        <geometry>
          <cylinder radius="0.0375" length="0.01"/>
        </geometry>
      </collision>
    </link>

    <joint name="caster_swivel_wheel_joint" type="continuous">
      <origin xyz="-0.026 0 -0.016"/>
      <parent link="caster_swivel"/>
      <child link="caster_wheel"/>
      <axis xyz="0 1 0"/>
      <limit effort="100" velocity="100" k_velocity="0"/>
      <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <!-- Center hubcap -->
    <link name="caster_hubcap">
      <inertial>
        <mass value="0.01"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.0124" ixy="0" ixz="0"
                 iyy="0.0152" iyz="0"
                 izz="0.0117"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://rasbot_description/meshes/p3dx/caster_hubcap.stl"/>
        </geometry>
        <material name="CasterGrey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0"/>
        <geometry>
          <box size="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <joint name="caster_wheel_hubcap_joint" type="fixed">
      <origin xyz="-0.0035 0 -0.001"/>
      <parent link="caster_wheel"/>
      <child link="caster_hubcap"/>
    </joint>

  </xacro:macro>

</robot>