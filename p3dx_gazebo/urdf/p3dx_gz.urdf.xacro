<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="p3dx">

    <xacro:include filename="$(find rasbot_description)/urdf/p3dx.urdf.xacro"/>

    <gazebo>
        <plugin filename="gz-sim-diff-drive-system"
                name="gz::sim::systems::DiffDrive">

            <left_joint>p3dx_left_wheel_joint</left_joint>
            <right_joint>p3dx_right_wheel_joint</right_joint>

            <wheel_separation>0.3</wheel_separation>
            <wheel_radius>0.09</wheel_radius>
            <topic>cmd_vel</topic>

            <odom_topic>odom</odom_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>
            <odom_publish_frequency>50</odom_publish_frequency>

            <tf_topic>/tf</tf_topic>
        </plugin>
    </gazebo>




    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system"
                name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <joint_name>p3dx_left_wheel_joint</joint_name>
            <joint_name>p3dx_right_wheel_joint</joint_name>
            <joint_name>base_caster_swivel_joint</joint_name>
            <joint_name>caster_swivel_wheel_joint</joint_name>
        </plugin>
    </gazebo>

    <xacro:include filename="$(find p3dx_gazebo)/urdf/robot_material_support.xacro"/>

</robot>