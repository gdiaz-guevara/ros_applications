<?xml version="1.0"?>
<robot name="jackal" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="PI" value="3.1415926535897931" />
  <xacro:property name="footprint_vertical_offset" value="-0.0655" />
  <xacro:property name="chassis_length" value="0.420" />
  <xacro:property name="chassis_width" value="0.310" />
  <xacro:property name="chassis_height" value="0.184" />

  <xacro:property name="wheel_radius" value="0.098" />
  <xacro:property name="wheel_width" value="0.040" />
  <xacro:property name="wheelbase" value="0.262" />
  <xacro:property name="track" value="0.37559" />
  <xacro:property name="wheel_vertical_offset" value="0.0345" />
  <xacro:property name="mount_spacing" value="0.120" />
  <xacro:property name="dummy_inertia" value="1e-09"/>

  <xacro:include filename="$(find jackal_description)/urdf/jackal_material.xacro"/>
  <xacro:include filename="$(find jackal_description)/urdf/base.urdf.xacro"/>
  <xacro:include filename="$(find jackal_description)/urdf/wheel.urdf.xacro"/>

  <xacro:jackal_base PI="${PI}" footprint_vertical_offset="${footprint_vertical_offset}" chassis_length="${chassis_length}" chassis_width="${chassis_width}" chassis_height="${chassis_height}" mount_spacing="${mount_spacing}" dummy_inertia="${dummy_inertia}"/>
  
  <xacro:wheel prefix="front_left" PI="${PI}" wheel_radius="${wheel_radius}" wheel_width="${wheel_width}">
    <origin xyz="${wheelbase/2} ${track/2} ${wheel_vertical_offset}" rpy="0 0 0" />
  </xacro:wheel>
  <xacro:wheel prefix="front_right" PI="${PI}" wheel_radius="${wheel_radius}" wheel_width="${wheel_width}">
    <origin xyz="${wheelbase/2} ${-track/2} ${wheel_vertical_offset}" rpy="0 0 0" />
  </xacro:wheel>
  <xacro:wheel prefix="rear_left" PI="${PI}" wheel_radius="${wheel_radius}" wheel_width="${wheel_width}">
    <origin xyz="${-wheelbase/2} ${track/2} ${wheel_vertical_offset}" rpy="0 0 0" />
  </xacro:wheel>
  <xacro:wheel prefix="rear_right" PI="${PI}" wheel_radius="${wheel_radius}" wheel_width="${wheel_width}">
    <origin xyz="${-wheelbase/2} ${-track/2} ${wheel_vertical_offset}" rpy="0 0 0" />
  </xacro:wheel>

  <xacro:include filename="$(find jackal_description)/urdf/accessories.urdf.xacro" />
</robot>